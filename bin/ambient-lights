#!/usr/bin/env python3
import time
import math
import os
import sys
import signal

DIFF_NODE = "/sys/devices/platform/soc/ffd00000.cbus/ffd1f000.i2c/i2c-0/0-0012/diff"
TOUCH_THRESHOLD = 90
IDLE_TIMEOUT = 5.0

class BalancedAmbient:
    def __init__(self):
        self.files = {}
        for z in [1, 2, 3]:
            self.files[f"r{z}"] = open(f"/sys/class/leds/micro:red:ring{z}/brightness", "w")
            self.files[f"g{z}"] = open(f"/sys/class/leds/micro:green:ring{z}/brightness", "w")
            self.files[f"b{z}"] = open(f"/sys/class/leds/micro:blue:ring{z}/brightness", "w")
        self.leds_active = False

    def set_ring(self, z, r, g, b):
        self.files[f"r{z}"].seek(0); self.files[f"r{z}"].write(f"{r}\n"); self.files[f"r{z}"].flush()
        self.files[f"g{z}"].seek(0); self.files[f"g{z}"].write(f"{g}\n"); self.files[f"g{z}"].flush()
        self.files[f"b{z}"].seek(0); self.files[f"b{z}"].write(f"{b}\n"); self.files[f"b{z}"].flush()

    def all_off(self):
        for z in [1, 2, 3]:
            self.set_ring(z, 0, 0, 0)
        self.leds_active = False

    def close(self):
        self.all_off()
        for f in self.files.values():
            try: f.close()
            except Exception: pass

def get_color(hue_deg, fade=1.0):
    h = (hue_deg % 360.0) / 60.0
    i = int(h)
    f = h - i
    if i == 0:   r, g, b = 1.0, f, 0.0          # Red -> Yellow
    elif i == 1: r, g, b = 1.0 - f, 1.0, 0.0    # Yellow -> Green
    elif i == 2: r, g, b = 0.0, 1.0, f          # Green -> Cyan
    elif i == 3: r, g, b = 0.0, 1.0 - f, 1.0    # Cyan -> Blue
    elif i == 4: r, g, b = f, 0.0, 1.0          # Blue -> Magenta
    else:        r, g, b = 1.0, 0.0, 1.0 - f    # Magenta -> Red
    
    # Качественная оптическая калибровка светодиодов:
    # Красный ставим на максимум (255), так как зеленый и синий светят в 3 раза ярче для глаза
    r_val = int((r ** 1.3) * 255 * fade)
    g_val = int((g ** 1.6) * 165 * fade)
    b_val = int((b ** 1.5) * 180 * fade)
    return r_val, g_val, b_val

def read_diff():
    try:
        with open(DIFF_NODE, "r") as f:
            lines = f.readlines()
        c0 = int(lines[0].split("=")[1].strip())
        c1 = int(lines[1].split("=")[1].strip())
        c2 = int(lines[2].split("=")[1].strip())
        return c0, c1, c2
    except Exception:
        return 0, 0, 0

def main():
    ctrl = BalancedAmbient()
    
    def on_exit(signum, frame):
        ctrl.close()
        sys.exit(0)
        
    signal.signal(signal.SIGINT, on_exit)
    signal.signal(signal.SIGTERM, on_exit)

    last_active_time = time.time()
    hue = 0.0
    fade = 0.0

    print("[*] Balanced Ambient: яркий глубокий красный, сочный изумруд, сапфир...")

    while True:
        c0, c1, c2 = read_diff()
        now = time.time()

        if c0 >= TOUCH_THRESHOLD or c1 >= TOUCH_THRESHOLD or c2 >= TOUCH_THRESHOLD:
            last_active_time = now
            if ctrl.leds_active:
                ctrl.all_off()
                fade = 0.0
            time.sleep(0.04)
            continue

        idle_duration = now - last_active_time

        if idle_duration >= IDLE_TIMEOUT:
            ctrl.leds_active = True
            fade = min(1.0, fade + 0.015)
            
            # Соседние цвета кольца с мягким перетеканием (сдвиг 50 градусов)
            r1, g1, b1 = get_color(hue, fade)
            r2, g2, b2 = get_color(hue + 50.0, fade)
            r3, g3, b3 = get_color(hue + 100.0, fade)

            ctrl.set_ring(1, r1, g1, b1)
            ctrl.set_ring(2, r2, g2, b2)
            ctrl.set_ring(3, r3, g3, b3)

            # Плавный шаг (полный оборот за ~16 секунд)
            hue = (hue + 0.45) % 360.0
            time.sleep(0.02) # 50 FPS
        else:
            if ctrl.leds_active:
                ctrl.all_off()
                fade = 0.0
            time.sleep(0.05)

if __name__ == "__main__":
    main()
