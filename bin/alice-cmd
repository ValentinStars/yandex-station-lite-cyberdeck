#!/usr/bin/env python3
import sys
import struct
import time
import subprocess

def inject_key(dev_path, key_code):
    # struct input_event: timeval (16 bytes), type (2), code (2), value (4) = 24 bytes
    with open(dev_path, 'wb') as f:
        # Key down
        f.write(struct.pack('qqHHi', 0, 0, 1, key_code, 1))
        f.write(struct.pack('qqHHi', 0, 0, 0, 0, 0)) # SYN_REPORT
        f.flush()
        time.sleep(0.08)
        # Key up
        f.write(struct.pack('qqHHi', 0, 0, 1, key_code, 0))
        f.write(struct.pack('qqHHi', 0, 0, 0, 0, 0)) # SYN_REPORT
        f.flush()

def send_text_query(query_text):
    p = subprocess.Popen(['/system/vendor/quasar/maind', '--cli'],
                         stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.3)
    p.stdin.write(b'q\n')
    p.stdin.flush()
    time.sleep(0.2)
    p.stdin.write(f'{query_text}\n'.encode('utf-8'))
    p.stdin.flush()
    time.sleep(1.0)
    p.terminate()

def main():
    if len(sys.argv) < 2:
        print('Использование: alice-cmd [pause|play|volup|voldn|mute|query "текст"]')
        sys.exit(1)
        
    cmd = sys.argv[1].lower()
    if cmd in ('pause', 'play', 'toggle'):
        inject_key('/dev/input/event1', 582)
        print('[✓] Отправлен триггер Play/Pause (Key 582)')
    elif cmd in ('volup', 'vol+'):
        inject_key('/dev/input/event1', 115)
        print('[✓] Громкость увеличена (+)')
    elif cmd in ('voldn', 'vol-'):
        inject_key('/dev/input/event1', 114)
        print('[✓] Громкость уменьшена (-)')
    elif cmd == 'mute':
        inject_key('/dev/input/event0', 113)
        print('[✓] Переключен Mute микрофона')
    elif cmd == 'query':
        query = ' '.join(sys.argv[2:]) if len(sys.argv) > 2 else 'пауза'
        print(f'[*] Отправка тихого запроса: "{query}"')
        send_text_query(query)
        print('[✓] Запрос отправлен в DirectiveSequencer')
    else:
        print(f'Неизвестная команда: {cmd}')

if __name__ == '__main__':
    main()
