#!/usr/bin/env python3
import time
import subprocess
import threading

DIFF_NODE = "/sys/devices/platform/soc/ffd00000.cbus/ffd1f000.i2c/i2c-0/0-0012/diff"
# Точный порог по 2-му раунду калибровки:
# Шум: 10-60
# Реальные жесты: 150 - 4380!
THRESHOLD = 140 

def play_sound_async(wav_path):
    def _play():
        subprocess.run(["play-audio", wav_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    t = threading.Thread(target=_play)
    t.daemon = True
    t.start()

def read_diff():
    try:
        with open(DIFF_NODE, "r") as f:
            lines = f.readlines()
        ch0 = int(lines[0].split("=")[1].strip())
        ch1 = int(lines[1].split("=")[1].strip())
        ch2 = int(lines[2].split("=")[1].strip())
        return ch0, ch1, ch2
    except Exception:
        return 0, 0, 0

def run_dj_mode():
    print("=" * 65)
    print("🎧 DJ WICKY-WICKY (PRO CALIBRATED V2)")
    print(f"Порог отсечки помех: Delta > {THRESHOLD} (шум 0-60 полностью подавлен)")
    print("Твои жесты:")
    print("  ► Один взмах вправо        -> ВИК!")
    print("  ◄ Один взмах влево         -> ВАК!")
    print("  ⇄ Два взмаха (туда-сюда)  -> ВИКИ-ВИКИ СКРЕТЧ!")
    print("=" * 65)
    print("🔥 Система готова! Маши над станцией (Ctrl+C для выхода)...")
    
    last_side = None
    last_side_t = 0.0
    last_play_t = 0.0
    
    while True:
        c0, c1, c2 = read_diff()
        now = time.time()
        
        cur_side = None
        if c0 >= THRESHOLD and c0 > c2:
            cur_side = "LEFT"
        elif c2 >= THRESHOLD and c2 > c0:
            cur_side = "RIGHT"
            
        if cur_side and cur_side != last_side:
            dt = now - last_side_t
            # Детекция быстрого реверса движения (ТУДА-СЮДА)
            if last_side is not None and (0.08 <= dt <= 0.75) and (now - last_play_t > 0.35):
                print(f"[{time.strftime('%H:%M:%S')}] ⇄ 🔥 ВИКИ-ВИКИ! (туда-сюда, dt={dt:.2f}s | c0={c0}, c2={c2})")
                play_sound_async("/data/scratch_combo.wav")
                last_play_t = now
                last_side = None # Сброс после комбо
            elif (now - last_play_t > 0.38):
                if cur_side == "RIGHT":
                    print(f"[{time.strftime('%H:%M:%S')}] ► Взмах вправо (c2={c2})")
                    play_sound_async("/data/scratch_fwd.wav")
                else:
                    print(f"[{time.strftime('%H:%M:%S')}] ◄ Взмах влево (c0={c0})")
                    play_sound_async("/data/scratch_bwd.wav")
                last_play_t = now
                last_side = cur_side
                
            last_side_t = now
            
        time.sleep(0.010) # 100 Hz опрос

if __name__ == "__main__":
    try:
        run_dj_mode()
    except KeyboardInterrupt:
        print("\n[!] DJ Mode остановлен.")
