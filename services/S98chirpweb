#!/bin/sh
case "$1" in
    start)
        echo "Starting Chirp Web 2007..."
        nohup /opt/bin/python3 /data/opt/chirp_web/server.py >/var/log/chirp_web.log 2>&1 &
        ;;
    stop)
        python3 -c 'import os, signal; [os.kill(int(p), signal.SIGKILL) for p in os.popen("pidof python3").read().split() if "chirp_web" in open(f"/proc/{p}/cmdline").read()]' 2>/dev/null
        ;;
    restart)
        python3 -c 'import os, signal; [os.kill(int(p), signal.SIGKILL) for p in os.popen("pidof python3").read().split() if "chirp_web" in open(f"/proc/{p}/cmdline").read()]' 2>/dev/null
        sleep 1
        nohup /opt/bin/python3 /data/opt/chirp_web/server.py >/var/log/chirp_web.log 2>&1 &
        ;;
esac
